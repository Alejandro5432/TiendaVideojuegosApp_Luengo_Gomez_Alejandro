<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainLayoutAltaJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvInfoNumJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvInfoNumJugadores"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvNumJugadores"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvNumJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintTop_toBottomOf="@+id/tvInfoNumJugadores"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMenosJugadores"
                app:layout_constraintStart_toEndOf="@id/btnMasJugadores"/>

            <Button
                android:id="@+id/btnMenosJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMenosJugadores"
                app:layout_constraintTop_toBottomOf="@id/tvInfoNumJugadores"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvNumJugadores" />

            <Button
                android:id="@+id/btnMasJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMasJugadores"
                app:layout_constraintTop_toBottomOf="@id/tvInfoNumJugadores"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvNumJugadores"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvNombreJuego"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvMostrarNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvMostrarNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/tvNombreJuego"
                app:layout_constraintBottom_toTopOf="@id/etEscribeNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etEscribeNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etEscribeNombreJuego"
                android:inputType="text"
                android:minHeight="48dp"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/btnCopiarNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMostrarNombreJuego" />

            <Button
                android:id="@+id/btnCopiarNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnCopiarNombreJuego"
                app:layout_constraintTop_toBottomOf="@id/etEscribeNombreJuego"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <CheckBox
                android:id="@+id/cbEnLaColeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cbEnLaColeccion"
                android:checked="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPulsaBoton"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvPulsaBoton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvPulsaBoton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnPulsame"
                app:layout_constraintStart_toEndOf="@id/cbEnLaColeccion" />

            <Button
                android:id="@+id/btnPulsame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnPulsame"
                android:enabled="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPulsaBoton"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvBotonPulsado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/gridLayout"
                app:layout_constraintTop_toTopOf="parent"/>

            <GridLayout
                android:id="@+id/gridLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                app:layout_constraintTop_toBottomOf="@id/tvBotonPulsado"
                app:layout_constraintBottom_toTopOf="@id/etDificultadJuego"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintDimensionRatio="1:1">

                <Button
                    android:id="@+id/btnPrimero"
                    android:text="@string/btnPrimero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnSegundo"
                    android:text="@string/btnSegundo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnTercero"
                    android:text="@string/btnTercero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnCuarto"
                    android:text="@string/btnCuarto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnQuinto"
                    android:text="@string/btnQuinto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnSexto"
                    android:text="@string/btnSexto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnSeptimo"
                    android:text="@string/btnSeptimo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnOctavo"
                    android:text="@string/btnOctavo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>

                <Button
                    android:id="@+id/btnNoveno"
                    android:text="@string/btnNoveno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    style="@style/EstiloBotones"/>
            </GridLayout>

            <EditText
                android:id="@+id/etDificultadJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etDificultadJuego"
                android:minHeight="48dp"
                android:text=""
                app:layout_constraintBottom_toTopOf="@id/tvDificultadIncorrecta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/gridLayout" />

            <TextView
                android:id="@+id/tvDificultadIncorrecta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AC1212"
                app:layout_constraintTop_toBottomOf="@id/etDificultadJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/RadioGroup"/>


            <RadioGroup
                android:id="@+id/RadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tvDificultadIncorrecta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnLimpiar">

                <RadioButton
                    android:id="@+id/rbNuevo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbNuevo" />

                <RadioButton
                    android:id="@+id/rbSegundaMano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbSegundaMano" />

                <RadioButton
                    android:id="@+id/rbAlquilado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbAlquilado" />

            </RadioGroup>

            <Button
                android:id="@+id/btnLimpiar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnLimpiar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/RadioGroup"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnEnviar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnVolverAlMenuAJ"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Button
                android:id="@+id/btnVolverAlMenuAJ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnVolverAlMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnEnviar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</ScrollView>