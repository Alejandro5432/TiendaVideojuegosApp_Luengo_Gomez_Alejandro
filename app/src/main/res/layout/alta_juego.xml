<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/mainLayoutAltaJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvNombreJuego"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvMostrarNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvMostrarNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                app:layout_constraintTop_toBottomOf="@id/tvNombreJuego"
                app:layout_constraintBottom_toTopOf="@id/etEscribeNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/etEscribeNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etEscribeNombreJuego"
                android:inputType="text"
                android:minHeight="48dp"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/btnCopiarNombreJuego"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvMostrarNombreJuego" />

            <Button
                android:id="@+id/btnCopiarNombreJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnCopiarNombreJuego"
                app:layout_constraintTop_toBottomOf="@id/etEscribeNombreJuego"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvInfoNumJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tvInfoNumJugadores"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Primera fila: mínimo de jugadores -->

            <TextView
                android:id="@+id/tvMinJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/tvMinJugadores"
                app:layout_constraintTop_toBottomOf="@id/tvInfoNumJugadores"
                app:layout_constraintBottom_toBottomOf="@id/btnMasJugadoresMin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMasJugadoresMin" />

            <Button
                android:id="@+id/btnMasJugadoresMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMasJugadores"
                app:layout_constraintTop_toBottomOf="@id/tvInfoNumJugadores"
                app:layout_constraintStart_toEndOf="@id/tvMinJugadores"
                app:layout_constraintEnd_toStartOf="@id/btnMenosJugadoresMin" />

            <Button
                android:id="@+id/btnMenosJugadoresMin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMenosJugadores"
                app:layout_constraintTop_toTopOf="@id/btnMasJugadoresMin"
                app:layout_constraintStart_toEndOf="@id/btnMasJugadoresMin"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Segunda fila: máximo de jugadores -->

            <TextView
                android:id="@+id/tvMaxJugadores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/tvMaxJugadores"
                app:layout_constraintTop_toBottomOf="@id/btnMasJugadoresMin"
                app:layout_constraintBottom_toBottomOf="@id/btnMasJugadoresMax"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnMasJugadoresMax" />

            <Button
                android:id="@+id/btnMasJugadoresMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMasJugadores"
                app:layout_constraintTop_toBottomOf="@id/btnMasJugadoresMin"
                app:layout_constraintStart_toEndOf="@id/tvMaxJugadores"
                app:layout_constraintEnd_toStartOf="@id/btnMenosJugadoresMax" />

            <Button
                android:id="@+id/btnMenosJugadoresMax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnMenosJugadores"
                app:layout_constraintTop_toTopOf="@id/btnMasJugadoresMax"
                app:layout_constraintStart_toEndOf="@id/btnMasJugadoresMax"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/etPrecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etPrecio"
                android:inputType="numberDecimal"
                android:minWidth="48dp"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@id/spGenero"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Spinner
                android:id="@+id/spGenero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@id/spEdadRecomendada"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etPrecio" />

            <Spinner
                android:id="@+id/spEdadRecomendada"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@id/btnFechaLanzamiento"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/spGenero" />

            <Button
                android:id="@+id/btnFechaLanzamiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnFechaLanzamiento"
                app:layout_constraintTop_toBottomOf="@id/spEdadRecomendada"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/etPlataformas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etPlataformas"
                android:inputType="textMultiLine"
                android:minLines="1"
                android:maxLines="3"
                app:layout_constraintTop_toBottomOf="@id/btnFechaLanzamiento"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/etDificultadJuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/etDificultadJuego"
                android:inputType="number"
                android:minHeight="48dp"
                app:layout_constraintBottom_toTopOf="@id/tvDificultadIncorrecta"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvDificultadIncorrecta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AC1212"
                app:layout_constraintBottom_toTopOf="@id/RadioGroup"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etDificultadJuego" />

            <RadioGroup
                android:id="@+id/RadioGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDificultadIncorrecta">

                <RadioButton
                    android:id="@+id/rbNuevo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbNuevo" />

                <RadioButton
                    android:id="@+id/rbSegundaMano"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbSegundaMano" />

                <RadioButton
                    android:id="@+id/rbAlquilado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rbAlquilado" />
            </RadioGroup>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnEnviar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnEnviar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnResetearCampos"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Button
                android:id="@+id/btnResetearCampos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnResetearCampos"
                app:layout_constraintStart_toEndOf="@id/btnEnviar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <Button
                android:id="@+id/btnVolverAlMenuAJ"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btnVolverAlMenu"
                app:layout_constraintTop_toBottomOf="@id/btnEnviar"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</ScrollView>